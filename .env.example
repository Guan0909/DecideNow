# ============================================
# DecideNow - 环境变量配置
# 复制此文件为 .env.local 并填入真实值
# ============================================

# AI 配置（OpenAI 兼容格式，支持 DeepSeek 等）
# 获取 DeepSeek API Key: https://platform.deepseek.com/api_keys
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro

# Supabase 配置
# 创建 Supabase 项目: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 高德地图 API Key（地址搜索和定位）
# 申请地址: https://console.amap.com
AMAP_API_KEY=your-amap-key-here

# 数据库连接（Supabase 提供的 PostgreSQL 连接串）
# 在 Supabase Dashboard → Settings → Database → Connection string 中找到
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
